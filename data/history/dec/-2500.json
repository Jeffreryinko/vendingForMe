[["k115259","페니키아",-2500,-64,0,"xx",[],0,"s","",106,0,1,"","페니키아(그리스어: Φοινίκη, 라틴어: Phœnicia)는 고대 가나안의 북쪽에 근거지를 둔 고대 문명이다.",-2500],["k179608","모헨조다로",-2500,-1700,0,"sa",["PK"],10,"e","",99,0,1,"","모헨조다로(신드어: موهن جو دڙو, 직역: '죽은 자들의 언덕')는 파키스탄 신드주 라르카나구에 있는 고고학 유적지이다.",-2500],["k996843","메로에",-2500,-1500,0,"af",["SD"],0,"s","",66,0,1,"","메로에(Meroë)는 아프리카 북동부, 수단 북부의 나일강 중류에 있는 고대 쿠시 왕국의 도시이다.",-2500],["k112132","라가시",-2500,-2000,0,"me",["IQ"],0,"s","",61,0,0,"","유프라테스강과 티그리스강 사이 거의 중간쯤에 위치한 라가시(아카드어 Lagaški; 수메르어 LAGAŠ = 𒉢𒁓𒆷𒆠 = NU11.BUR.LAKI); 현대의 텔 알히바(Tell al-Hiba)는 수메",-2500],["k303807","이집트 제5왕조",-2498,-2345,0,"af",["EG"],0,"s","",53,0,1,"","이집트 제5왕조는 이집트 고왕국의 한 시기로, 기원전 2498년부터 기원전 2345년까지 존속하였다.",-2498],["k220917","네페리르카레 카카이",null,-2465,0,"af",["EG"],0,"p","",41,0,1,"","네페리르카레는 이집트 제5왕조의 파라오이다.",-2465],["k239270","멘카우호르",-2500,-2420,0,"af",["EG"],0,"p","",41,0,1,"","멘카우호르는 이집트 제5왕조의 파라오이다.",-2460],["k220919","솁세스카레",-2450,null,0,"af",["EG"],0,"p","",41,0,1,"","솁세스카레는 이집트 제5왕조의 파라오이다.",-2460],["k239269","니우세르레",-2500,-2430,0,"af",["EG"],0,"p","",40,0,1,"","니우세르레는 이집트 제5왕조의 파라오이다.",-2460],["k239273","제드카레",-2500,-2380,0,"af",["EG"],0,"p","",40,0,1,"","제드카레는 이집트 제5왕조의 파라오이다.",-2460],["k220929","네페레프레",-2480,-2455,0,"af",["EG"],0,"p","",40,0,1,"","네페레프레는 이집트 제5왕조의 파라오이다.",-2455],["k1034564","프타호텝",-2450,-2400,0,"af",["EG"],9,"p","",40,0,1,"","프타호텝(Ptahhotep)은 이집트 제5왕조에 있었던 도시 관리자이자 고관이었다.",-2410],["k311369","우세르카레",-2500,-2330,0,"af",["EG"],0,"p","",37,0,1,"","우세르카레는 아비도스 왕 목록에 나오는 이집트 제6왕조의 파라오이다.",-2460],["k174012","에안나툼",-2500,-2425,0,"me",["IQ"],0,"p","",33,0,1,"","에안나툼은 수메르의 라가시 왕으로 역사적으로 검증 가능한 왕국 중 하나를 최초로 세웠다.",-2460]]