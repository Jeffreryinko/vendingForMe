{"id":"k103874","qid":"Q259705","title":"히고국","en":"Higo Province","desc":"과거 일본 사이카이도에 설치되었던 율령국","k":"event","y":10,"y2":null,"ya":10,"md":"","e":0,"r":"동아시아","c":["JP"],"s":[],"h":"","g":"","n":29,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Old_Japan_Higo.svg/500px-Old_Japan_Higo.svg.png?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"히고국(일본어: 肥後国 히고노쿠니[*])은 사이카이도에 설치된 일본의 옛 구니이다.","lead":"히고국(일본어: 肥後国 히고노쿠니[*])은 사이카이도에 설치된 일본의 옛 구니이다. 현재의 구마모토현에 해당한다.\n히 국(火国/肥国)을 분할하여 7세기 말에 성립되었다. 히고 국(肥後国)이 《속일본기》에 처음 등장하는 지토 천황 10년(696년) 이전의 어느 시점에선가 히젠국과 히고 국이 나뉘었다고 추정된다.","secs":[],"heads":[["군",2]],"full":false,"cut":true,"links":["사이카이도","구니","구마모토현","히 국","속일본기","지토 천황","히젠국","다마나군","기쿠치군","아소군","아키타군","에도 시대","시모마시키군","가미마시키군","야쓰시로군","아마쿠사군","아시키타군","구마군"],"rel":{"part":[["Taikoku",""]],"follows":[["히국","히국"]]},"occ":[],"cls":["율령국"],"cats":["구마모토현의 역사","사이카이도","율령국","히고국"],"src":{"site":"ko.wikipedia.org","title":"히고국","url":"https://ko.wikipedia.org/wiki/%ED%9E%88%EA%B3%A0%EA%B5%AD","rev":39048053,"edited":"2025-04-04","license":"CC BY-SA 4.0"},"at":"2026-11-04"}