{"id":"k1426174","qid":"Q2627082","title":"봄베이주","en":"Bombay State","desc":"인도의 과거 주","k":"event","y":1947,"y2":1960,"ya":1947,"md":"08-15","e":6,"r":"남·동남아시아","c":["IN"],"s":[],"h":"저항과 변화","g":"","n":23,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Bombay_1956-1960_de.svg/500px-Bombay_1956-1960_de.svg.png?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"봄베이주는 인도의 폐지된 행정 구역이다.","lead":"봄베이주는 인도의 폐지된 행정 구역이다. 1947년 인도의 독립과 함께 설치된 주이다. 인도 번왕국들이나 다른 주의 마라티어권 지역이나 구자라트어권 지역을 합쳐 주역이 크게 확장되었다. 1960년 언어권에 따라 남쪽의 마하라슈트라주와 북쪽의 구자라트주로 나뉘고 폐지되었다.","secs":[],"heads":[],"full":true,"cut":false,"links":["인도의 독립","인도 번왕국","마라티어","구자라트어","마하라슈트라주","구자라트주"],"rel":{"follows":[["Bombay Presidency",""],["Deccan States Agency",""],["Baroda, Western India and Gujarat States Agency",""],["하이데라바드주","하이데라바드주"]],"followed":[["구자라트주","구자라트주"],["마하라슈트라주","마하라슈트라주"],["카르나타카주","카르나타카주"],["라자스탄주","라자스탄주"]]},"occ":[],"cls":["state of India","province of India","과거에 존재했던 행정 구역"],"cats":["1947년 설치","1960년 폐지","구자라트주","마하라슈트라주","인도의 역사","인도의 폐지된 행정 구역"],"src":{"site":"ko.wikipedia.org","title":"봄베이주","url":"https://ko.wikipedia.org/wiki/%EB%B4%84%EB%B2%A0%EC%9D%B4%EC%A3%BC","rev":41393055,"edited":"2026-02-21","license":"CC BY-SA 4.0"},"at":"2026-11-04"}