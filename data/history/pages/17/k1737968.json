{"id":"k1737968","qid":"Q7151879","title":"폴 L. 프리먼 주니어","en":"Paul L. Freeman Jr.","desc":"United States Army general (1907–1988)","k":"person","y":1907,"y2":1988,"ya":1947,"md":"","e":6,"r":"북미","c":["US","PH"],"s":[],"h":"전쟁 속 사람들","g":"","n":7,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Paul_L_Freeman.jpg/500px-Paul_L_Freeman.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"폴 L.","lead":"폴 L. 프리먼 주니어(Paul Lamar Freeman, Jr., 1907년 6월 29일 ~ 1988년 4월 17일)는 1962년부터 1965년까지 미국 육군의 4성 장군으로 복무하면서 미국 유럽 육군을 이끌었던 총사령관이었다. 한국 전쟁 당시 그는 지평리 전투와 제1·2차 원주 전투에서 활약했으며 전쟁이 끝난 이후에는 미국 국방참모대학교에서 일하기도 했다.","secs":[],"heads":[],"full":true,"cut":false,"links":["미국 육군","미국 유럽 육군","한국 전쟁","지평리 전투","제1·2차 원주 전투","미국 국방참모대학교"],"rel":{"conf":[["제2차 세계 대전","제2차 세계 대전"],["6·25 전쟁","6.25 전쟁"]]},"occ":["군인"],"cls":["사람"],"cats":["1907년 출생","1988년 사망","미국 국방대학교 동문","미국 국방참모대학교 동문","미국 육군 대장","미국 육군보병학교 동문","미국 육군사관학교 동문","미국 육군야전포병학교 동문","미국 육군지휘참모대학교 동문","미국 육군참모대학교 동문"],"src":{"site":"ko.wikipedia.org","title":"폴 L. 프리먼 주니어","url":"https://ko.wikipedia.org/wiki/%ED%8F%B4_L._%ED%94%84%EB%A6%AC%EB%A8%BC_%EC%A3%BC%EB%8B%88%EC%96%B4","rev":39456969,"edited":"2025-04-25","license":"CC BY-SA 4.0"},"at":"2026-11-04"}