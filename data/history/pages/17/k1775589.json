{"id":"k1775589","qid":"Q11655474","title":"마나베 아키토키","en":null,"desc":"(1690-1724)","k":"person","y":1690,"y2":1724,"ya":1724,"md":"","e":2,"r":"동아시아","c":["JP"],"s":[],"h":"골목길 미시사","g":"","n":2,"img":null,"one":"마나베 아키토키(間部詮言)는 에도 시대 중기의 다이묘이다.","lead":"마나베 아키토키(間部詮言)는 에도 시대 중기의 다이묘이다. 에치고 무라카미번(越後村上藩) 제2대 번주, 에치젠 사바에 번(越前鯖江藩) 초대 번주를 지냈다. 마나베 가 제2대 당주.\n말년에 사촌이자 사위인 마나베 아키미치에게 후사를 맡겼다.","secs":[],"heads":[],"full":false,"cut":false,"links":["에도 시대","다이묘","에치고국","무라카미번","에치젠국","사바에 번","마나베 씨","마나베 아키미치 (1709년)"],"rel":{},"occ":[],"cls":["사람"],"cats":["1690년 출생","1724년 사망","마나베씨","무라카미번주","사바에번주"],"src":{"site":"ko.wikipedia.org","title":"마나베 아키토키","url":"https://ko.wikipedia.org/wiki/%EB%A7%88%EB%82%98%EB%B2%A0_%EC%95%84%ED%82%A4%ED%86%A0%ED%82%A4","rev":39466237,"edited":"2025-04-26","license":"CC BY-SA 4.0"},"at":"2026-11-04"}