{"id":"k1832890","qid":"Q6635813","title":"다누마 오키타카","en":null,"desc":"일본의 에도 시대 후기의 다이묘 (1819-1870)","k":"person","y":1819,"y2":1870,"ya":1859,"md":"","e":3,"r":"","c":[],"s":[],"h":"골목길 미시사","g":"","n":2,"img":null,"one":"다누마 오키타카(일본어: 田沼意尊, 1819년 ~ 1870년 1월 25일)는 막말의 다이묘이다.","lead":"다누마 오키타카(일본어: 田沼意尊, 1819년 ~ 1870년 1월 25일)는 막말의 다이묘이다. 에도 막부에선 와카도시요리를 역임하였다. 도토미 사가라번주, 가즈사 고쿠보 번 초대 번주를 지냈다. 사가라 번 다누마가(相良藩田沼家) 제8대 당주. 증조부는 다누마 오키쓰구이다.","secs":[],"heads":[],"full":false,"cut":false,"links":["막말","다이묘","에도 막부","와카도시요리","도토미국","사가라번","가즈사국","고쿠보 번","다누마씨","다누마 오키쓰구"],"rel":{},"occ":[],"cls":["사람"],"cats":["1819년 출생","1870년 사망","가즈사국의 번주","다누마씨","막말의 다이묘","막말의 막부 사람","사가라번주","에도 막부 와카도시요리","지번사","후다이 다이묘"],"src":{"site":"ko.wikipedia.org","title":"다누마 오키타카","url":"https://ko.wikipedia.org/wiki/%EB%8B%A4%EB%88%84%EB%A7%88_%EC%98%A4%ED%82%A4%ED%83%80%EC%B9%B4","rev":39481317,"edited":"2025-04-27","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{}}