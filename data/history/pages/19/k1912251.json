{"id":"k1912251","qid":"Q11431952","title":"오쿠보 쓰네하루","en":null,"desc":"일본의 무사","k":"person","y":1675,"y2":1728,"ya":1715,"md":"","e":2,"r":"동아시아","c":["JP"],"s":[],"h":"골목길 미시사","g":"","n":2,"img":null,"one":"오쿠보 쓰네하루(일본어: 大久保常春, 1675년 3월 27일 ~ 1728년 10월 11일)는 에도 시대 중기의 다이묘이다.","lead":"오쿠보 쓰네하루(일본어: 大久保常春, 1675년 3월 27일 ~ 1728년 10월 11일)는 에도 시대 중기의 다이묘이다. 시모쓰케 가라스야마 번 초대 번주를 지냈다. 에도 막부에선 와카도시요리, 노중을 역임하였다. 가라스야마 번 오쿠보가(烏山藩大久保家) 제2대 당주.","secs":[],"heads":[],"full":false,"cut":false,"links":["에도 시대","다이묘","시모쓰케국","가라스야마 번","에도 막부","와카도시요리","노중","오쿠보씨"],"rel":{},"occ":[],"cls":["사람"],"cats":["1675년 출생","1728년 사망","가라스야마번주","에도 막부 노중","에도 막부 와카도시요리","오미국의 번주","오쿠보씨","후다이 다이묘"],"src":{"site":"ko.wikipedia.org","title":"오쿠보 쓰네하루","url":"https://ko.wikipedia.org/wiki/%EC%98%A4%EC%BF%A0%EB%B3%B4_%EC%93%B0%EB%84%A4%ED%95%98%EB%A3%A8","rev":39496808,"edited":"2025-04-27","license":"CC BY-SA 4.0"},"at":"2026-11-04"}