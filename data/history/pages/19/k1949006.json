{"id":"k1949006","qid":"Q60749","title":"페르디난트 크리스티안 바우어","en":"Ferdinand Christian Baur","desc":"독일 신학자","k":"person","y":1792,"y2":1860,"ya":1832,"md":"","e":3,"r":"유럽","c":["DE"],"s":["뷔르템베르크 왕국"],"h":"믿음과 금기","g":"","n":32,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Christoph_F_D%C3%B6rr_-_Dr_FC_von_Baur_-_Stahlstich_1830er.jpg/500px-Christoph_F_D%C3%B6rr_-_Dr_FC_von_Baur_-_Stahlstich_1830er.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"페르디난트 크리스티안 바우어(독일어: Ferdinand Christian Baur, 1792년 6월 21일 - 1860년 12월) 독일의 개신교 신학자이자 튀빙겐 학파의 창설자이자 리더였다.","lead":"페르디난트 크리스티안 바우어(독일어: Ferdinand Christian Baur, 1792년 6월 21일 - 1860년 12월) 독일의 개신교 신학자이자 튀빙겐 학파의 창설자이자 리더였다. 헤겔의 변증법을 따라서 바우어는 제 2세기 초기 기독교는 유대주의 기독교(베드로 기독교)와 이방 기독교(바울 기독교)의 종합으로 주장하였다. 바우어의 작품은 성경 본문에 대한 역사비평에 큰 영향을 주었다.","secs":[],"heads":[["추가 자료",2]],"full":true,"cut":false,"links":["독일","개신교","튀빙겐 학파","헤겔","변증법","초기 기독교","유대 기독교인","역사비평"],"rel":{},"occ":["church historian","대학 교수","작가","Protestant theologian"],"cls":["사람"],"cats":["1792년 출생","1860년 사망","그리스도 신화론","기독교 신학자","독일의 성서학자","슈투트가르트 출신","튀빙겐 대학교 교수","튀빙겐 대학교 동문","헤겔주의"],"src":{"site":"ko.wikipedia.org","title":"페르디난트 크리스티안 바우어","url":"https://ko.wikipedia.org/wiki/%ED%8E%98%EB%A5%B4%EB%94%94%EB%82%9C%ED%8A%B8_%ED%81%AC%EB%A6%AC%EC%8A%A4%ED%8B%B0%EC%95%88_%EB%B0%94%EC%9A%B0%EC%96%B4","rev":41339316,"edited":"2026-02-14","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"work":[["DE",""]],"born":[["DE",""]],"nat":[["DE","뷔르템베르크 왕국"]]}}