{"id":"k221971","qid":"Q711051","title":"삼별초","en":"Sambyeolcho","desc":"고려시대의 무장 단체","k":"event","y":null,"y2":null,"ya":null,"md":"","e":-1,"r":"동아시아","c":["KR"],"s":["고려"],"h":"전쟁 속 사람들","g":"P","n":7,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/Donhwamun_Gate_02.jpg/500px-Donhwamun_Gate_02.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"삼별초(三別抄)는 몽골 침략기에 그에 대항하던 고려의 무장 세력이며, 원래는 하나의 단일한 단체가 아니었다.","lead":"삼별초(三別抄)는 몽골 침략기에 그에 대항하던 고려의 무장 세력이며, 원래는 하나의 단일한 단체가 아니었다. 뒤에 삼별초의 난을 일으킨다. 다른 반란군과는 달리 원래는 비정규군이었다가 정규군으로 재편된 군대였다. 제주도에서 궤멸하였다는 것이 통설이나, 일부 세력이 류큐 왕국(오키나와 지역)으로 향하였다는 주장도 제기되고 있다.","secs":[],"heads":[["유래",2],["대몽항쟁의 배경",2],["대몽항쟁",2],["결과",3],["일본과의 관계",2],["기타 정보",2],["역대 지휘자",3],["고려 군대 계보",3]],"full":false,"cut":true,"links":["몽골 침략기","고려","삼별초의 난","류큐 왕국","최우","몽골 제국","강화군","김준 (고려 후기)","최충헌","최의","임연","임유무","고려 원종","원나라","개경","몽골","명단","배중손","노영희","왕온 (승화후)","진도 (진도군)","최씨 정권","경상도","전라도","조세","용장사","산성 (건조물)","일본","제주도","벽파진"],"rel":{"conf":[["삼별초의 난","삼별초 항쟁"]]},"occ":[],"cls":["군사부대"],"cats":["고려-몽골 전쟁","고려-원나라 관계","고려의 부대 및 편성","고려의 정치","고려의 정치 단체","무신정권","삼별초","우라소에시의 역사"],"src":{"site":"ko.wikipedia.org","title":"삼별초","url":"https://ko.wikipedia.org/wiki/%EC%82%BC%EB%B3%84%EC%B4%88","rev":41086982,"edited":"2026-01-01","license":"CC BY-SA 4.0"},"at":"2026-11-04"}