{"id":"k2575336","qid":"Q923514","title":"브록 치점","en":"Brock Chisholm","desc":"캐나다 의사","k":"person","y":1896,"y2":1971,"ya":1936,"md":"","e":5,"r":"북미","c":["CA"],"s":[],"h":"발견과 실수","g":"","n":23,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Brock_Chisholm_2.jpg/500px-Brock_Chisholm_2.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"브록 치점(영어: Brock Chisholm)은 캐나다의 정신과 의사이다.","lead":"브록 치점(영어: Brock Chisholm)은 캐나다의 정신과 의사이다. 세계보건기구의 초대 사무총장을 역임하였다. 제1차 세계 대전에 참전하였고 제2차 세계 대전 중 캐나다 육군의 의무총감을 역임하였다. 1944년 캐나다 보건복지부의 차관을 지낸 후 1948부터 1953년까지 WHO의 사무총장으로 보직하였다.","secs":[],"heads":[],"full":true,"cut":false,"links":["캐나다","정신의학","의사","세계보건기구","제1차 세계 대전","제2차 세계 대전","캐나다 육군","의무총감 (캐나다)"],"rel":{"conf":[["제1차 세계 대전","제1차 세계 대전"],["제2차 세계 대전","제2차 세계 대전"]]},"occ":["정신과의사","정치인","의사"],"cls":["사람"],"cats":["1896년 출생","1971년 사망","19세기 캐나다 사람","20세기 캐나다 사람","세계 보건 기구 직원","캐나다의 불가지론자","캐나다의 유엔 직원","캐나다의 정신의학자","캐나다의 제1차 세계 대전 참전 군인","토론토 대학교 동문"],"src":{"site":"ko.wikipedia.org","title":"브록 치점","url":"https://ko.wikipedia.org/wiki/%EB%B8%8C%EB%A1%9D_%EC%B9%98%EC%A0%90","rev":39557251,"edited":"2025-04-30","license":"CC BY-SA 4.0"},"at":"2026-11-04"}