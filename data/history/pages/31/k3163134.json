{"id":"k3163134","qid":"Q233987","title":"알렉세예브나 소피아","en":"Sophia Alekseyevna of Russia","desc":"Russian tsarevna (1657–1704)","k":"person","y":1657,"y2":1704,"ya":1697,"md":"","e":2,"r":"유럽","c":["RU"],"s":["러시아 차르국"],"h":"권력의 밀실","g":"","n":50,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Sophia_Alekseyevna_of_Russia.jpg/500px-Sophia_Alekseyevna_of_Russia.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"알렉세예브나 소피아(Со́фья Алексе́евна, 1657년 9월 27일 ~ 1704년 7월 14일)는 1682년부터 1689년까지 치리한 러시아 차르국의 섭정이다.","lead":"알렉세예브나 소피아(Со́фья Алексе́евна, 1657년 9월 27일 ~ 1704년 7월 14일)는 1682년부터 1689년까지 치리한 러시아 차르국의 섭정이다.\n알렉세이 미하일로비치의 셋째 딸로 태어났다. 형제 표도르 3세가 1682년 4월 27일 사망하자 소피나는 자신의 뜻과 관계 없이 러시아의 정치에 휘말리게 되었다.","secs":[],"heads":[],"full":true,"cut":false,"links":["러시아 차르국","섭정","알렉세이 미하일로비치","표도르 3세"],"rel":{},"occ":["통치자","정치인"],"cls":["사람"],"cats":[],"src":{"site":"ko.wikipedia.org","title":"알렉세예브나 소피아","url":"https://ko.wikipedia.org/wiki/%EC%95%8C%EB%A0%89%EC%84%B8%EC%98%88%EB%B8%8C%EB%82%98_%EC%86%8C%ED%94%BC%EC%95%84","rev":40599089,"edited":"2025-09-11","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"work":[["RU",""]],"born":[["RU",""]],"nat":[["RU","러시아 차르국"]]}}