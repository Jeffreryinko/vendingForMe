{"id":"k335288","qid":"Q16164882","title":"산음동 병기연구소","en":null,"desc":"","k":"event","y":null,"y2":null,"ya":null,"md":"","e":-1,"r":"동아시아","c":["KR"],"s":[],"h":"","g":"","n":1,"img":null,"one":"산음동 병기연구소는 조선민주주의인민공화국 평양시 산음동에 위치한 미사일 공장이다.","lead":"산음동 병기연구소는 조선민주주의인민공화국 평양시 산음동에 위치한 미사일 공장이다.\n자강도 강계시 남천동 부근 화학병기 연구소에서는 미사일 연료통을 생산하고 청천강 부근의 38호 공장에선 전기회로를 생산하며 전체 조립은 평양시 산음동에 있는 공장에서 한다. 조선민주주의인민공화국의 미사일 연구, 생산시설은 잠진 군수공장, 산음동 병기연구소, 자강도 전천의 별하리 병기공장과 황북 사리원 무기공장의 5곳이다.","secs":[],"heads":[["역사",2],["대포동 미사일",2],["1998년 최초 발사",3],["2006년 2회 발사",3],["2009년 3회 발사",3],["2009년 4회 발사",3]],"full":false,"cut":true,"links":["조선민주주의인민공화국","자강도","강계시","미사일","청천강","평양시","잠진 군수공장","별하리 병기공장","사리원 무기공장","광명성 4호","화성 15호","워싱턴포스트","2019년 북미정상회담","동창리 미사일 발사장","대포동 1호","대포동 2호","대한민국","남포시","무수단리 미사일 발사장"],"rel":{},"occ":[],"cls":[],"cats":["북핵문제","조선민주주의인민공화국의 핵기술","핵무기 개발"],"src":{"site":"ko.wikipedia.org","title":"산음동 병기연구소","url":"https://ko.wikipedia.org/wiki/%EC%82%B0%EC%9D%8C%EB%8F%99_%EB%B3%91%EA%B8%B0%EC%97%B0%EA%B5%AC%EC%86%8C","rev":39123126,"edited":"2025-04-08","license":"CC BY-SA 4.0"},"at":"2026-11-04"}