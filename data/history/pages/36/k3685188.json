{"id":"k3685188","qid":"Q122053772","title":"2023년 가봉 쿠데타","en":"2023 Gabonese coup d'état","desc":"military coup in Gabon on 30 August 2023","k":"event","y":2023,"y2":2023,"ya":2023,"md":"08-30","e":7,"r":"아프리카","c":["GA"],"s":[],"h":"권력의 밀실","g":"","n":36,"img":null,"one":"2023년 가봉 쿠데타는 2023년 8월 30일에 발생한 쿠데타이다.","lead":"2023년 가봉 쿠데타는 2023년 8월 30일에 발생한 쿠데타이다. 2023년 가봉 총선을 둘러싼 경합과 정치적 긴장 속에서 8월 26일에 치러진 선거 이후, 8월 29일에 재선에 성공한 대통령 알리 봉고 온딤바를 축출하려는 쿠데타가 발생했다.","secs":[],"heads":[],"full":true,"cut":false,"links":["2023년 가봉 총선","알리 봉고 온딤바"],"rel":{"prev":[["2019 Gabonese coup d'etat attempt",""]],"people":[["Committee for the Transition and Restoration of Institutions",""],["Gabonese Republican Guard",""],["브리스 올리기 응게마","브리스 올리귀"]]},"occ":[],"cls":["military coup"],"cats":["2023년 8월","2023년 가봉","2023년 분쟁","가봉 정부","가봉의 정치","가봉의 쿠데타"],"src":{"site":"ko.wikipedia.org","title":"2023년 가봉 쿠데타","url":"https://ko.wikipedia.org/wiki/2023%EB%85%84_%EA%B0%80%EB%B4%89_%EC%BF%A0%EB%8D%B0%ED%83%80","rev":41254444,"edited":"2026-01-25","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"at":[["GA",""]]}}