{"id":"k3691661","qid":"Q122700456","title":"2023년 아제르바이잔의 나고르노카라바흐 공세","en":"2023 Azerbaijani offensive in Nagorno-Karabakh","desc":"2023 military offensive against the self-declared breakaway state of Artsakh","k":"event","y":2023,"y2":2023,"ya":2023,"md":"09-19","e":7,"r":"중동·중앙아시아","c":["AZ","AM"],"s":[],"h":"전쟁 속 사람들","g":"","n":44,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/2020_Nagorno-Karabakh_war.svg/500px-2020_Nagorno-Karabakh_war.svg.png?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"2023년 아제르바이잔의 나고르노카라바흐 공세는 아제르바이잔과 아르차흐 공화국간의 충돌이다.","lead":"2023년 아제르바이잔의 나고르노카라바흐 공세는 아제르바이잔과 아르차흐 공화국간의 충돌이다. 2023년 9월 19일에서 20일 사이에, 아제르바이잔은 자칭 탈퇴국인 아르차흐를 상대로 군사 공세를 시작했다. 이 공세는 국제적으로 아제르바이잔의 일부로 인정되지만 아르메니아인들이 다수 거주하는 나고르노카라바흐의 분쟁 지역에서 일어났다. 이번 공격은 아제르바이잔이 아르차흐 공화국을 봉쇄하면서 위기가 고조되는 가운데 발생했으며, 이로 인해 해당 지역에서의 식량, 의약품 및 기타 물품과 같은 필수 물품이 크게 부족해졌다.","secs":[],"heads":[],"full":true,"cut":false,"links":["아제르바이잔","아르차흐 공화국","아르차흐","아르메니아인","나고르노카라바흐"],"rel":{"part":[["나고르노카라바흐 분쟁","나고르노카라바흐 분쟁"]],"people":[["아제르바이잔군","아제르바이잔군"],["Artsakh Defense Army",""]],"effect":[["2023 Armenian protests",""],["expulsion of Nagorno-Karabakh Armenians",""],["아제르바이잔군","아제르바이잔군"]],"evt":[["Nagorno-Karabakh fuel depot explosion",""]]},"occ":[],"cls":["군사 공격"],"cats":["2023년 9월","2023년 국제 관계","2023년 분쟁","2023년 전투","나고르노카라바흐 분쟁"],"src":{"site":"ko.wikipedia.org","title":"2023년 아제르바이잔의 나고르노카라바흐 공세","url":"https://ko.wikipedia.org/wiki/2023%EB%85%84_%EC%95%84%EC%A0%9C%EB%A5%B4%EB%B0%94%EC%9D%B4%EC%9E%94%EC%9D%98_%EB%82%98%EA%B3%A0%EB%A5%B4%EB%85%B8%EC%B9%B4%EB%9D%BC%EB%B0%94%ED%9D%90_%EA%B3%B5%EC%84%B8","rev":41873128,"edited":"2026-06-05","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"at":[["AZ",""],["AM",""]]}}