{"id":"k3805189","qid":"Q62129","title":"프리드리히 아우구스트 2세 폰 올덴부르크 대공","en":"Frederick Augustus II of Oldenburg","desc":"German noble (1852-1931); Grand Duke from 1900 until 1918","k":"person","y":1852,"y2":1931,"ya":1892,"md":"","e":4,"r":"유럽","c":["DE"],"s":[],"h":"전쟁 속 사람들","g":"","n":28,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/August_II_von_Oldenburg_1902.jpg/500px-August_II_von_Oldenburg_1902.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"프리드리히 아우구스트 2세(Frederick Augustus II, 1852년 11월 16일 ~ 1931년 2월 24일)는 올덴부르크의 마지막 통치 대공이다.","lead":"프리드리히 아우구스트 2세(Frederick Augustus II, 1852년 11월 16일 ~ 1931년 2월 24일)는 올덴부르크의 마지막 통치 대공이다. 그는 마리아 안나 폰 안할트데소 왕녀와 프리드리히 카를 폰 프로이센 왕자의 딸인 엘리자베트 안나 폰 프로이센 왕녀와 결혼했다. 그녀가 죽은 후, 그는 엘리자베트 알렉산드린 폰 메클렌부르크슈베린 왕녀와 결혼했다.","secs":[],"heads":[],"full":true,"cut":false,"links":["올덴부르크","마리아 안나 폰 안할트데소 왕녀","프리드리히 카를 폰 프로이센 왕자","엘리자베트 안나 폰 프로이센 왕녀","엘리자베트 알렉산드린 폰 메클렌부르크슈베린 왕녀"],"rel":{},"occ":["통치자"],"cls":["사람"],"cats":["1852년 출생","1931년 사망","독일 황립해군 제독","올덴부르크 대공","올덴부르크 출신","왕위 요구자","폐위된 유럽의 군주","프로이센의 기병대장"],"src":{"site":"ko.wikipedia.org","title":"프리드리히 아우구스트 2세 폰 올덴부르크 대공","url":"https://ko.wikipedia.org/wiki/%ED%94%84%EB%A6%AC%EB%93%9C%EB%A6%AC%ED%9E%88_%EC%95%84%EC%9A%B0%EA%B5%AC%EC%8A%A4%ED%8A%B8_2%EC%84%B8_%ED%8F%B0_%EC%98%AC%EB%8D%B4%EB%B6%80%EB%A5%B4%ED%81%AC_%EB%8C%80%EA%B3%B5","rev":39779830,"edited":"2025-05-10","license":"CC BY-SA 4.0"},"at":"2026-11-04"}