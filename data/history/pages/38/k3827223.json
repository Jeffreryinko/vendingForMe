{"id":"k3827223","qid":"Q973502","title":"룩셈부르크 공녀 엘리자베트 (1922년)","en":"Princess Elisabeth of Luxembourg (1922–2011)","desc":"Luxembourgian Royal (1922–2011)","k":"person","y":1922,"y2":2011,"ya":1962,"md":"","e":6,"r":"유럽","c":["LU"],"s":[],"h":"권력의 밀실","g":"","n":23,"img":null,"one":"룩셈부르크 공녀 엘리자베트(Princess Elisabeth of Luxembourg, 1922년 12월 22일 ~ 2011년 11월 22일)는 룩셈부르크의 공녀이다.","lead":"룩셈부르크 공녀 엘리자베트(Princess Elisabeth of Luxembourg, 1922년 12월 22일 ~ 2011년 11월 22일)는 룩셈부르크의 공녀이다. 그녀는 장 대공의 여동생이자 앙리 대공의 고모이며 샤를로트와 부르봉파르마의 펠릭스의 딸이었다. 1956년에 그녀는 호헨베르크 공작 프란츠와 결혼했다.","secs":[],"heads":[],"full":true,"cut":false,"links":["룩셈부르크","장 (룩셈부르크)","앙리 (룩셈부르크)","샤를로트 (룩셈부르크)","부르봉파르마의 펠릭스","호헨베르크 공작 프란츠"],"rel":{},"occ":["귀족"],"cls":["사람"],"cats":["1922년 출생","2011년 사망","나사우바일부르크가","룩셈부르크의 공녀","호헨베르크가"],"src":{"site":"ko.wikipedia.org","title":"룩셈부르크 공녀 엘리자베트 (1922년)","url":"https://ko.wikipedia.org/wiki/%EB%A3%A9%EC%85%88%EB%B6%80%EB%A5%B4%ED%81%AC_%EA%B3%B5%EB%85%80_%EC%97%98%EB%A6%AC%EC%9E%90%EB%B2%A0%ED%8A%B8_%281922%EB%85%84%29","rev":42587159,"edited":"2026-10-01","license":"CC BY-SA 4.0"},"at":"2026-11-04"}