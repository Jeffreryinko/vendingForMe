{"id":"k3889424","qid":"Q467124","title":"유대교와 기독교의 분열","en":"Split of Christianity and Judaism","desc":"aspect of history","k":"event","y":null,"y2":null,"ya":null,"md":"","e":-1,"r":"","c":[],"s":[],"h":"믿음과 금기","g":"B","n":13,"img":null,"one":"유대교와 기독교의 분열(הפילוג היהודי-נוצרי)은 다음과 같다.","lead":"유대교와 기독교의 분열(הפילוג היהודי-נוצרי)은 다음과 같다. 기독교는 제2성전 유대교에 뿌리를 두고 있지만 기독교 시대의 첫 세기에 두 종교가 갈라지기 시작다. 유대교인, 유대 기독교인, 사도 바울로의 이방인 기독교의 상호작용이 있었다. 정확히 두 종교가 갈라진 시점은 논쟁거리다.","secs":[],"heads":[],"full":true,"cut":false,"links":["기독교","제2성전 유대교","서력기원","유대 기독교인","사도 바울로"],"rel":{},"occ":[],"cls":["분야사"],"cats":["고대 유대사","기독교-유대교 관련 논란","초기 기독교와 유대교"],"src":{"site":"ko.wikipedia.org","title":"유대교와 기독교의 분열","url":"https://ko.wikipedia.org/wiki/%EC%9C%A0%EB%8C%80%EA%B5%90%EC%99%80_%EA%B8%B0%EB%8F%85%EA%B5%90%EC%9D%98_%EB%B6%84%EC%97%B4","rev":41251068,"edited":"2026-01-25","license":"CC BY-SA 4.0"},"at":"2026-11-04"}