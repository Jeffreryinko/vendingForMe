{"id":"k3934657","qid":"Q2985554","title":"서치라이트 작전","en":"Operation Searchlight","desc":"Pakistani military operation in the 1971 Bangladesh Liberation War","k":"event","y":1971,"y2":null,"ya":1971,"md":"05-25","e":6,"r":"남·동남아시아","c":["PK"],"s":[],"h":"기묘한 사건록","g":"","n":16,"img":null,"one":"서치라이트 작전(Operation Searchlight)은 파키스탄군이 동파키스탄에서 벵골 민족주의자를 진압하기 위해 벌인 작전이다.","lead":"서치라이트 작전(Operation Searchlight)은 파키스탄군이 동파키스탄에서 벵골 민족주의자를 진압하기 위해 벌인 작전이다. 방글라데시 독립 전쟁이 촉발되었고, 인도가 참전하여 동파키스탄은 방글라데시로 독립하였다.","secs":[],"heads":[],"full":true,"cut":false,"links":["파키스탄군","동파키스탄","방글라데시 독립 전쟁","인도","방글라데시"],"rel":{"part":[["방글라데시 독립 전쟁","방글라데시 독립 전쟁"]],"people":[["파키스탄 육군","파키스탄 육군"],["묵티 바히니","동파키스탄 해방군"],["방글라데시 임시정부","방글라데시 임시정부"],["아와미 연맹","아와미 연맹"],["방글라데시","방글라데시"],["파키스탄","파키스탄"],["파키스탄군","파키스탄군"],["타주딘 아흐마드","타주딘 아흐마드"],["M. A. G. Osmani",""],["야히아 칸","야히아 칸"]]},"occ":[],"cls":["군사작전"],"cats":["1971년 12월","1971년 3월","1971년 방글라데시","1971년 파키스탄","방글라데시-파키스탄 관계","방글라데시 독립 전쟁","파키스탄이 저지른 전쟁 범죄"],"src":{"site":"ko.wikipedia.org","title":"서치라이트 작전","url":"https://ko.wikipedia.org/wiki/%EC%84%9C%EC%B9%98%EB%9D%BC%EC%9D%B4%ED%8A%B8_%EC%9E%91%EC%A0%84","rev":41202147,"edited":"2026-01-14","license":"CC BY-SA 4.0"},"at":"2026-11-04"}