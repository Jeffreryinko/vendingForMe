{"id":"k4000912","qid":"Q4470213","title":"허먼 위트킨","en":"Herman Witkin","desc":"미국 심리학자","k":"person","y":1916,"y2":1979,"ya":1956,"md":"","e":6,"r":"북미","c":["US"],"s":[],"h":"문화와 예술","g":"","n":10,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Herman_Witkin_%281977%29%2C_Bestanddeelnr_929-4540.jpg/500px-Herman_Witkin_%281977%29%2C_Bestanddeelnr_929-4540.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"허먼 A.","lead":"허먼 A. 위트킨(1916년 8월 2일~1979년 7월 8일)은 미국의 심리학자로 인지 이론 발달의 선구자였다. 다른 인지 심리학자들이 학습 장애에 대해 설문지법으로 진단하던 것에 반해 위트킨은 투영 검사법과 문제 해결법을 사용했다. 장(field)의존-장독립 이론을 제안한 심리학자로 가장 잘 알려져 있다.","secs":[],"heads":[],"full":true,"cut":false,"links":["미국","심리학자","투영 검사법"],"rel":{},"occ":["심리학자"],"cls":["사람"],"cats":["1916년 출생","1979년 사망","미국의 심리학자"],"src":{"site":"ko.wikipedia.org","title":"허먼 위트킨","url":"https://ko.wikipedia.org/wiki/%ED%97%88%EB%A8%BC_%EC%9C%84%ED%8A%B8%ED%82%A8","rev":41349707,"edited":"2026-02-15","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"born":[["US",""]],"nat":[["US",""]]}}