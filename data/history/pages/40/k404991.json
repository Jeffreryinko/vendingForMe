{"id":"k404991","qid":"Q1077294","title":"하떠이성","en":"Hà Tây province","desc":"former province of Vietnam","k":"event","y":2008,"y2":2009,"ya":2008,"md":"","e":7,"r":"남·동남아시아","c":["VN"],"s":[],"h":"","g":"","n":21,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Su%E1%BB%91i_Y%E1%BA%BFn%2C_ch%C3%B9a_H%C6%B0%C6%A1ng.jpg/500px-Su%E1%BB%91i_Y%E1%BA%BFn%2C_ch%C3%B9a_H%C6%B0%C6%A1ng.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"하떠이성(하서성, 베트남어: Hà Tây / 河西)은 예전에 존재했던 베트남의 성 단위 지방 자치체였다.","lead":"하떠이성(하서성, 베트남어: Hà Tây / 河西)은 예전에 존재했던 베트남의 성 단위 지방 자치체였다. 2008년 8월 1일 하노이에 흡수 합병되었다. 홍강 삼각주 지방에 위치하며, 하노이의 서쪽으로 경계를 인접하고 있었다. 성도는 하동(베트남어: 河東 / Hà Đông, 현재의 하노이 하동군)이었다.","secs":[],"heads":[["행정 구역",2]],"full":false,"cut":true,"links":["베트남","홍강 삼각주","하노이","하동군 (베트남)"],"rel":{"followed":[["하노이","하노이"]]},"occ":[],"cls":["former provinces of Vietnam"],"cats":["베트남의 폐지된 성","하노이의 역사"],"src":{"site":"ko.wikipedia.org","title":"하떠이성","url":"https://ko.wikipedia.org/wiki/%ED%95%98%EB%96%A0%EC%9D%B4%EC%84%B1","rev":41450106,"edited":"2026-03-06","license":"CC BY-SA 4.0"},"at":"2026-11-04"}