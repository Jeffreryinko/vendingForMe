{"id":"k407610","qid":"Q312916","title":"논노스","en":"Nonnus","desc":"Greek epic poet","k":"person","y":500,"y2":500,"ya":500,"md":"","e":1,"r":"아프리카","c":["EG","IT"],"s":["아이깁투스"],"h":"문화와 예술","g":"~","n":46,"img":null,"one":"논노스(그리스어: Νόννος)는 고대 그리스의 서사시 시인이다.","lead":"논노스(그리스어: Νόννος)는 고대 그리스의 서사시 시인이다. 그는 이집트 테베의 파나폴리스(아크민) 출신으로, 아마 4세기 말에서 5세기 초 인물로 보인다. 그는 디오니소스 신의 이야기인 '디오니시아카'(Dionysiaca)와 요한 복음의 설명문, 그리고 소실된 작품인 시 두 편 '거인들의 전투'와 '바사리카'를 썼다.","secs":[],"heads":[],"full":true,"cut":false,"links":["그리스어","고대 그리스","시인","이집트","테베 (이집트)","아크민","디오니소스","요한의 복음서"],"rel":{},"occ":["시인","작가"],"cls":["사람"],"cats":["5세기 동로마인","5세기 시인","5세기 이집트 사람","고대 이집트의 시인","동로마 제국의 시인","디오니소스","생몰년 미상","서사시인"],"src":{"site":"ko.wikipedia.org","title":"논노스","url":"https://ko.wikipedia.org/wiki/%EB%85%BC%EB%85%B8%EC%8A%A4","rev":39152590,"edited":"2025-04-10","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"born":[["EG",""]],"nat":[["IT","아이깁투스"]]}}