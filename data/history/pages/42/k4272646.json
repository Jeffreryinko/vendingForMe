{"id":"k4272646","qid":"Q5546814","title":"데이비드 L. 얼라라","en":null,"desc":"American chemist","k":"person","y":1937,"y2":null,"ya":1977,"md":"","e":6,"r":"북미","c":["US"],"s":[],"h":"발견과 실수","g":"","n":3,"img":null,"one":"데이비드 L.","lead":"데이비드 L. 얼라라(David L. Allara)는 미국의 화학자이다. 펜실베이니아 주립 대학교에서 화학 및 재료과학 명예 특훈 교수로 재직했으며, 고체 표면에서 분자가 스스로 배열되는 자기조립 단분자층과 표면·계면의 화학적·물리적 성질을 연구했다.","secs":[],"heads":[["생애와 경력",2],["연구",2],["수상",2]],"full":false,"cut":true,"links":["펜실베이니아 주립 대학교","자기조립 단분자층","나노 기술","화학 센서","생체 센서","카블리상"],"rel":{},"occ":["화학자"],"cls":["사람"],"cats":["미국의 화학자","재료과학자","펜실베이니아 주립 대학교 교수"],"src":{"site":"ko.wikipedia.org","title":"데이비드 L. 얼라라","url":"https://ko.wikipedia.org/wiki/%EB%8D%B0%EC%9D%B4%EB%B9%84%EB%93%9C_L._%EC%96%BC%EB%9D%BC%EB%9D%BC","rev":42574052,"edited":"2026-09-29","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"born":[["US",""]],"nat":[["US",""]]}}