{"id":"k4282601","qid":"Q141302786","title":"페드로 마리아 몰리나 마르케스","en":null,"desc":"Venezuelan supercentenarian","k":"person","y":1915,"y2":null,"ya":1955,"md":"","e":6,"r":"중남미","c":["VE"],"s":[],"h":"권력의 밀실","g":"","n":2,"img":null,"one":"페드로 마리아 몰리나 마르케스(Pedro María Molina Márquez, 1915년 4월 27일 ~ )는 베네수엘라의 슈퍼센티네리언이다.","lead":"페드로 마리아 몰리나 마르케스(Pedro María Molina Márquez, 1915년 4월 27일 ~ )는 베네수엘라의 슈퍼센티네리언이다. 2024년 5월 1일 후아나 우르비나 프란치의 사망 이후 베네수엘라 최고령자가 되었다. 2024년 4월 2일 후안 비센테 페레즈 모라가 사망 이후 베네수엘라 최고령 남성이 되었다.","secs":[],"heads":[["생애",2]],"full":false,"cut":true,"links":["베네수엘라","슈퍼센티네리언","후아나 우르비나 프란치","후안 빈센테 페레스"],"rel":{},"occ":[],"cls":["사람"],"cats":["1915년 출생","메리다주 출신"],"src":{"site":"ko.wikipedia.org","title":"페드로 마리아 몰리나 마르케스","url":"https://ko.wikipedia.org/wiki/%ED%8E%98%EB%93%9C%EB%A1%9C_%EB%A7%88%EB%A6%AC%EC%95%84_%EB%AA%B0%EB%A6%AC%EB%82%98_%EB%A7%88%EB%A5%B4%EC%BC%80%EC%8A%A4","rev":42661121,"edited":"2026-10-15","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"born":[["VE",""]],"nat":[["VE",""]]}}