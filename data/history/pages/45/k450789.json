{"id":"k450789","qid":"Q34063","title":"호세 가스파르 로드리게스 데 프란시아","en":"José Gaspar Rodríguez de Francia","desc":"스페인으로부터 독립을 이끌어낸 파라과이의 지도자이다.","k":"person","y":1766,"y2":1840,"ya":1806,"md":"","e":3,"r":"중남미","c":["PY","ES"],"s":["스페인 제국"],"h":"권력의 밀실","g":"","n":42,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/Jos%C3%A9_Gaspar_Rodr%C3%ADguez_de_Francia.jpg/500px-Jos%C3%A9_Gaspar_Rodr%C3%ADguez_de_Francia.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"호세 가스파르 로드리게스 데 프란시아(스페인어: José Gaspar Rodríguez de Francia y Velasco, 1766년 1월 6일~1840년 9월 20일)는 스페인으로부터 독립을 이끌어낸 파라과이의 지도자이다.","lead":"호세 가스파르 로드리게스 데 프란시아(스페인어: José Gaspar Rodríguez de Francia y Velasco, 1766년 1월 6일~1840년 9월 20일)는 스페인으로부터 독립을 이끌어낸 파라과이의 지도자이다. 파라과이 초대 집정관을 맡았으며, 1814년부터 1840년까지 나라를 운영하면서 외세배격과 고립을 기조로 하는 쇄국정책을 실시했다. 자주 프란시아 박사(Dr.)로도 불린다.","secs":[],"heads":[],"full":true,"cut":false,"links":["파라과이"],"rel":{},"occ":["변호사","정치인"],"cls":["사람"],"cats":["1766년 출생","1840년 사망","19세기 파라과이 사람","남아메리카 독립 전쟁 관련자","로마 가톨릭교회에서 파문된 사람","스페인계 파라과이인","파라과리주 출신","파라과이의 대통령","포르투갈계 파라과이인"],"src":{"site":"ko.wikipedia.org","title":"호세 가스파르 로드리게스 데 프란시아","url":"https://ko.wikipedia.org/wiki/%ED%98%B8%EC%84%B8_%EA%B0%80%EC%8A%A4%ED%8C%8C%EB%A5%B4_%EB%A1%9C%EB%93%9C%EB%A6%AC%EA%B2%8C%EC%8A%A4_%EB%8D%B0_%ED%94%84%EB%9E%80%EC%8B%9C%EC%95%84","rev":41678443,"edited":"2026-04-22","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"born":[["PY",""]],"nat":[["ES","스페인 제국"],["PY",""]]}}