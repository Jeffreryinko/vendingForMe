{"id":"k489135","qid":"Q6012680","title":"미케노스","en":null,"desc":"mythical son of Sparton","k":"event","y":null,"y2":null,"ya":null,"md":"","e":-1,"r":"","c":[],"s":[],"h":"믿음과 금기","g":"B","n":4,"img":null,"one":"미케노스 또는 미세노스(Misenos)는 그리스 신화에 등장하는 인물이다.","lead":"미케노스 또는 미세노스(Misenos)는 그리스 신화에 등장하는 인물이다. 미케네 시의 도시이름이 된 명조로, 미케네의 전설적인 건국자였다. 그러나 다른 전승에 의하면 미케네의 건국자는 페르세우스라는 전승도 있다.","secs":[],"heads":[],"full":true,"cut":false,"links":["그리스 신화","미케네","페르세우스"],"rel":{},"occ":[],"cls":["mythological Greek character"],"cats":["그리스 신화","그리스 신화의 인물"],"src":{"site":"ko.wikipedia.org","title":"미케노스","url":"https://ko.wikipedia.org/wiki/%EB%AF%B8%EC%BC%80%EB%85%B8%EC%8A%A4","rev":39170373,"edited":"2025-04-11","license":"CC BY-SA 4.0"},"at":"2026-11-04"}