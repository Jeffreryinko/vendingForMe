{"id":"k665255","qid":"Q149481","title":"비아드리나 유럽 대학교","en":"European University Viadrina","desc":"university","k":"event","y":1991,"y2":null,"ya":1991,"md":"","e":7,"r":"유럽","c":["DE"],"s":[],"h":"권력의 밀실","g":"","n":22,"img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/2004-viadrina_-main_building_Sicherlich.JPG/500px-2004-viadrina_-main_building_Sicherlich.JPG?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail","one":"비아드리나 유럽 대학교(Europa-Universität Viadrina)는 독일 브란덴부르크주 프랑크푸르트에 있는 대학교이다.","lead":"비아드리나 유럽 대학교(Europa-Universität Viadrina)는 독일 브란덴부르크주 프랑크푸르트에 있는 대학교이다. 독일의 대학교 중 가장 동쪽에 위치해 있으며 비아드리나라는 이름은 '오데르강에 있는'이라는 의미의 라틴어에서 유래했다. 2010/2011년 겨울학기에는 6,452명의 학생이 등록했는데 그 중 독일 학생이 77%, 폴란드 학생이 12%였으며 이외에 84개국에서 온 유학생들이 11%를 차지했다. 현재 총장은 전 유엔주재 독일 대사 군터 플로이거(Gunter Pleuger)이다.","secs":[],"heads":[],"full":true,"cut":false,"links":["독일","브란덴부르크주","프랑크푸르트 (오데르)","오데르강","라틴어"],"rel":{"follows":[["Alma Mater Viadrina",""]]},"occ":[],"cls":["공립 대학","재단"],"cats":["1506년 개교","1811년 폐지","1991년 개교","브란덴부르크주의 대학교","비아드리나 유럽 대학교","신성 로마 제국","프랑크푸르트 (오데르)의 건축물","프랑크푸르트 (오데르)의 교육"],"src":{"site":"ko.wikipedia.org","title":"비아드리나 유럽 대학교","url":"https://ko.wikipedia.org/wiki/%EB%B9%84%EC%95%84%EB%93%9C%EB%A6%AC%EB%82%98_%EC%9C%A0%EB%9F%BD_%EB%8C%80%ED%95%99%EA%B5%90","rev":39213888,"edited":"2025-04-13","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"at":[["DE",""]]}}